{
  "name": "archnm",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "An open source, self-hosted architecture diagram tool: one model of a software system, many views, saved as YAML in git and edited live by people and AI agents.",
  "keywords": [
    "architecture-diagram",
    "software-architecture",
    "c4-model",
    "diagrams-as-code",
    "yaml",
    "mcp",
    "webmcp",
    "ai-agents",
    "self-hosted",
    "real-time-collaboration"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EzekielEnns/archnemesis.git"
  },
  "homepage": "https://ezekielenns.github.io/archnemesis/",
  "bugs": "https://github.com/EzekielEnns/archnemesis/issues",
  "bin": {
    "archnm": "cli/archnm.ts"
  },
  "scripts": {
    "archnm": "node cli/archnm.ts",
    "dev": "node server/main.ts",
    "build": "pnpm typecheck && vite build && vite build -c vite.channel.config.ts && vite build -c vite.index.config.ts",
    "build:npm": "pnpm build && node scripts/build-npm.ts",
    "build:static": "vite build --mode static --outDir dist-static",
    "start": "vite build && NODE_ENV=production node server/main.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:run",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:bank": "eslint . --prune-suppressions && prettier --write eslint-suppressions.json",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "knip": "knip",
    "test:run": "vitest run",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@hocuspocus/provider": "^4.9.0",
    "@hocuspocus/server": "^4.9.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@resvg/resvg-wasm": "2.6.2",
    "elkjs": "^0.12.1",
    "libavoid-js": "0.5.0-beta.5",
    "lucide-react": "^1.77.0",
    "pixi.js": "^8.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.38.0",
    "ws": "^8.23.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yaml": "^2.9.1",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "knip": "^6.48.0",
    "lefthook": "^2.2.4",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js": ">=1.13.6"
    }
  }
}
